{
  "name": "physics-level-editor",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "smoke": "npm run build && electron . --phase2-smoke",
    "build": "tsc --noEmit && vite build && node build-electron.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "tsc --noEmit && npm test"
  },
  "engines": { "node": ">=22" },
  "dependencies": { "ajv": "^8.17.1", "ajv-formats": "^3.0.1", "react": "^19.3.0", "react-dom": "^19.3.0" },
  "devDependencies": {
    "@types/node": "^24.0.0", "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0",
    "electron": "^44.9.3", "typescript": "^5.9.3", "vite": "^8.3.5"
  }
}
